generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Roles {
  ADMIN
  USER
  COOK
  DELIVERY
}

model User {
  id                 String              @id @default(auto()) @map("_id") @db.ObjectId
  email              String              @unique
  password           String
  role               Roles
  name               String
  // Uniqueness is checked in the register handler: a unique index would also
  // treat every missing phone as a duplicate.
  phone              String?
  address            Address[]
  orders             Order[]
  isEmailVerified    Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  verificationTokens VerificationToken[]
  payments           Payment[]
}

model Address {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  address   String
  city      String?
  state     String?
  zip       String?
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  orders    Order[]
}

model Order {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  userId        String       @db.ObjectId
  addressId     String       @db.ObjectId
  totalPrice    Float
  ingredientIds String[]     @db.ObjectId
  ingredients   Ingredient[] @relation(fields: [ingredientIds], references: [id])
  isCustomOrder Boolean      @default(false)
  address       Address      @relation(fields: [addressId], references: [id])

  status    OrderStatus
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  pizzaIds  String[]    @db.ObjectId
  pizzas    Pizza[]     @relation(fields: [pizzaIds], references: [id])
  user      User        @relation(fields: [userId], references: [id])
  payments  Payment[]
}

model Ingredient {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  type        IngredientType @relation(fields: [typeId], references: [id])
  typeId      String         @db.ObjectId
  stock       Int
  imageUrl    String?        @default("")
  description String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  orderIds    String[]       @db.ObjectId
  orders      Order[]        @relation(fields: [orderIds], references: [id])
  pizzaIds    String[]       @db.ObjectId
  pizzas      Pizza[]        @relation(fields: [pizzaIds], references: [id])
}

model IngredientType {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String       @unique
  ingredients Ingredient[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Pizza {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String
  price       Float
  imageUrl    String?      @default("")
  ingredientIds String[]   @db.ObjectId
  ingredients Ingredient[] @relation(fields: [ingredientIds], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  orderIds    String[]     @db.ObjectId
  orders      Order[]      @relation(fields: [orderIds], references: [id])
}

model VerificationToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String        @db.ObjectId
  order     Order         @relation(fields: [orderId], references: [id])
  amount    Float
  status    PaymentStatus
  reference String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?  @db.ObjectId
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  SENT_TO_KITCHEN
  READY_FOR_DELIVERY
  SENT_TO_DELIVERY
  DELIVERED_TO_CUSTOMER
  CANCELLED
}
