# Copy this file to `.env` and fill in the values. Never commit `.env`.

# ── Server ───────────────────────────────────────────────
PORT=4000
# Used to build links in verification / password-reset emails
CLIENT_URL=http://localhost:5173

# ── Database (MongoDB, must be a replica set – Atlas is by default) ──
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pizza-delivery?retryWrites=true&w=majority

# ── Authentication ───────────────────────────────────────
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Email (SMTP) ─────────────────────────────────────────
# For Gmail, use an App Password, not your normal password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@pizzadelivery.com

# ── Razorpay (test mode) ─────────────────────────────────
# Leave as-is to use the built-in offline simulation.
RAZORPAY_KEY_ID=rzp_test_sample_key
RAZORPAY_KEY_SECRET=rzp_test_sample_secret

# ── Cloudinary (image hosting – not used by any route yet) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Inventory ────────────────────────────────────────────
# Ingredients with stock below this number trigger the admin alert email
LOW_STOCK_THRESHOLD=20
